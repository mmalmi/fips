#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=08
start_service() {
	local mode address
	config_load freedom_guest
	config_get mode main mode off
	[ "$mode" != off ] || return 0
	config_get address main address
	[ -n "$address" ] || return 1
	if ! nft list set inet fw4 freedom_clients >/dev/null 2>&1; then
		fw4 check && fw4 reload && nft list set inet fw4 freedom_clients >/dev/null || return 1
	fi
	procd_open_instance portal
	procd_set_param command /usr/sbin/freedom-guest
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
	# This listener never forwards DNS. Purchased devices use their advertised resolver.
	procd_open_instance captive_dns
	procd_set_param command /usr/sbin/dnsmasq -k --conf-file=/dev/null --no-resolv --no-hosts --bind-interfaces --except-interface=lo --listen-address="$address" --port=2053 --address="/#/$address" --local-ttl=0
	procd_set_param respawn
	procd_close_instance
}
stop_service() {
	nft flush set inet fw4 freedom_uplink 2>/dev/null || true
}
service_stopped() {
	# procd has requested termination. Cleanup waits for the daemon's lock,
	# and also handles a stopped/crashed daemon without touching its journal.
	/usr/sbin/freedom-guest --cleanup
}
service_triggers() {
	procd_add_reload_trigger freedom_guest
}
