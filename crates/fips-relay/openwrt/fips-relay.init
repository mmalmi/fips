#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load fips-relay
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get executable main executable /usr/sbin/fips-relay
	config_get config_path main config /etc/fips-relay/config.json
	[ -x "$executable" ] && [ -s "$config_path" ] || return 1
	procd_open_instance main
	procd_set_param command "$executable" run "$config_path"
	procd_set_param file "$config_path"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 65
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger fips-relay
}
